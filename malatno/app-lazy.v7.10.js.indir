    function getPercentage(numerator, denominator) {
        if (!denominator || isNaN(denominator) || denominator == 0) return 0;
        if (isNaN(numerator)) return 0;
        return fNumb((numerator / denominator) * 100);
    }

    $(window).on('resize scroll', function () {
