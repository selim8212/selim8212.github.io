    const loaderEl = `<div class="d-flex justify-content-center mt-5 mx-auto"><div id="postSpinner"class="lds-ring"><div class="black"></div><div class="black"></div><div class="black"></div><div class="black"></div></div></div>`;
    
    /** remove options kalo ngga ada di show */
