                                                        </p>
        
                                                        ${w.is_de ? `
                                                            <div class="wrapper-description card-description-wishlist">
                                                                <div class="card-description ellipsis-text description-elipsis">
                                                                    <span class="text-description text-description-wishlist">${DOMPurify.sanitize((w.de))}</span>
                                                                </div>
                                                                <a href="javascript:void(0)" class="show-details">${lang.SHOW_DETAIL}</a>
                                                            </div>
                                                        ` : ''}

                                                        <div class="wrapper-description">
                                                            <div class="card-description">
                                                                <p class="mb-2"><span class="current-currency">${userdata.base_currency}</span><span class="wishlist-card-price" data-origin-price="${w.to}">${w.to}</span> <b>(${getPercentage(w.to, w.pr)}%)</b></p>
                                                                <div class="progress progress-bar-striped progress-bar-animated" style="border-radius: 10px;"> 
                                                                    <div class="progress-bar bg-primary-green" style="background-color: #76cc10;border-radius: 10px;width: ${getPercentage(w.to, w.pr)}%;" role="progressbar" style="width: 10%" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100"></div>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        ${w.is_co ?
                                                            `<div class="wrapper-description">
                                                                <div class="card-description card-description-wishlist ellipsis-text description-elipsis">
                                                                    <span class="text-description text-description-wishlist-result"><b>${lang.CONTRIBUTORS}</b>: ${
                                                                        w.co.map (c => {
                                                                            return `
                                                                                ${c.na} <span style="color: #76CC11">(<span class="current-currency">${userdata.base_currency}</span><span class="wishlist-card-price" data-origin-price="${c.to}"></span>)</span>`;
                                                                        })
                                                                    }</span>
                                                                </div>
                                                                <a href="javascript:void(0)" class="show-details">${lang.SHOW_DETAIL}</a>
                                                            </div>`
                                                            
                                                         : ``}
        
                                                        <button class="btn button-card show-form-donate" data-form-type="donate" data-wishlist-id="${w.id}">${lang.SELECT_THIS}</button>
                                                    </div>
                                                </div>
                                            </div>
                                        `);

                                        setTimeout(() => {
                                            // let showDetails = document.querySelectorAll(".card-description-wishlist");
                                            let showDetails = document.querySelectorAll(".text-description-wishlist");
                                            showDetails.forEach((element) => {
                                                if ($(element).height() > 42) {
                                                    $(element).parent().parent().find("a").addClass("d-inline-block");
                                                    $(element).parent().parent().find("a").removeClass("d-none");
                                                  } else {
                                                    $(element).parent().parent().find("a").addClass("d-none");
                                                    $(element).parent().parent().find("a").removeClass("d-inline-block");
                                                  }
                                            });

                                            let showDetails2 = document.querySelectorAll(".text-description-wishlist-result");
                                            showDetails2.forEach((element) => {
                                                if ($(element).height() > 42) {
                                                    $(element).parent().parent().find("a").addClass("d-inline-block");
                                                    $(element).parent().parent().find("a").removeClass("d-none");
                                                  } else {
                                                    $(element).parent().parent().find("a").addClass("d-none");
                                                    $(element).parent().parent().find("a").removeClass("d-inline-block");
                                                  }
                                            });

                                            $("#masonry-wishlist-content").imagesLoaded(function () {
                                                $("#masonry-wishlist-content").masonry({
                                                    itemSelector: ".grid-item",
                                                    isFitWidth: true,
                                                    horizontalOrder: true,
                                                    gutter: 40,
                                                });
                                            });
                                        }, 150);
        
        
                                    })
                                } else {
                                    $('#wishlist-container').removeClass('d-inline-block').addClass('d-none');
                                }
                            })
                            .always(() => {
                                hasLoaded.wishlist = true;
                                reqToLoad.wishlist = false;
                                changeCurrencyTribe();
                            })
                    }
                } else if(!userdata.wishlist_show) {
                    $('#wishlist-container').removeClass('d-inline-block').addClass('d-none');
                    hasLoaded.wishlist = true;
                    reqToLoad.wishlist = false;
                } else {
                    if(!hasWishlist && hasLoaded.wishlist) {
                        console.log('remove wishlist container');
                        $('#wishlist-container').removeClass('d-inline-block').addClass('d-none');
                        hasLoaded.wishlist = true;
                        reqToLoad.wishlist = false;
                    }
                }
            }, 1000);
        }

        /** load options section */
        /** cek apakah masuk ke viewport */
        if ($('#options-container').isInViewport()) {
            /** cek apa 1 detik kemudian masih ada di viewport */
            setTimeout(() => {
                if (!hasLoaded.options && !reqToLoad.options && userdata.options_show) {
                    $('#options-container').html(loaderEl)
                    if ($('#options-container').isInViewport()) {
                        reqToLoad.options = true;
                        $.getq('tribe', `/${userdata.username}/tribe/options-api`, function (res) {
                                const resd = JSON.parse(atob(res.data));
                                $('#options-container').html('')
                                if (userdata.options_title) {
                                    $('#options-container').append(`
                                        <div class="container-layout  mt-customTop min-vh-0 mb-0">
                                            <h3 class="title-tribe mb-0">${DOMPurify.sanitize(he.encode(userdata.options_title))}</h3>
                                        </div>
                                    `);
                                } else {
                                    $('#options-container').append(`
                                        <div class="container-layout  mt-customTop min-vh-0 mb-0">
                                            <h3 class="title-tribe mb-0"></h3>
                                        </div>
                                    `);
                                }
        
                                if (resd.os) {
                                    $('#options-container').append(`
                                        <div class="container-big">
                                            <div class="grid d-flex flex-wrap margin-auto-custom justify-content-center" id="masonry-content"></div>
                                        </div>
                                    `);
                                    resd.os.map(o => {
                                        $('#masonry-content').append(`
                                            <div class="grid-item p-0 padding-column wrapper-card padding-column wrapper-card">
                                                <div class="card card-support">
                                                    ${o.im ? `<img src="${s3}files/profile/influencer/${userdata.username}/${o.im}" alt="2" class="img-support lazy img-responsive" onerror="this.style.display='none'">` : '' }
                                                    <div class="card-body card-body__padding">
                                                        <h6 class="card-title">${o.t}</h6>
                                                        <p class="card-currency">
                                                            <span class="current-currency">${userdata.base_currency}</span><span class="dukungan-card-price" data-origin-price="${o.p}">${o.pf}</span>
                                                        </p>
                                                        
                                                        ${(o.ec > 0 || o.l > 0 || o.edo ) ? `
                                                            <div class="card-benefits">
                                                                ${o.ec > 0 ? `
                                                                    <div class="benefit d-flex align-items-start mb-2">
                                                                        <img src="data:image/svg+xml;base64," alt="" class="mr-7 img-benefit mt-1 img-news">
                                                                        <p class="text-benefit">
                                                                            ${(o.ec > 1) 
                                                                                ? lang.GET_EXCLUSIVE_CONTENT2.replace(2, o.ec) 
                                                                                : lang.GET_EXCLUSIVE_CONTENT1
                                                                            }
                                                                        </p>
                                                                    </div>
                                                                ` : ''}
                                                                ${o.l > 0 ? `
                                                                    <div class="benefit d-flex align-items-start mb-2">
                                                                        <img src="data:image/svg+xml;base64," alt="" class="mr-2 img-benefit mt-1 img-exlamation">
                                                                        <p class="text-benefit" ${o.il ? `style="color:red"` : ''}>
                                                                            ${(o.il) 
                                                                                ? lang.LIMITED_NO_LEFT.replace('0', (o.l - o.s)).replace('12', o.l).replace('( ', '(')
                                                                                : lang.LIMITED_LEFT.replace('0', (o.l - o.s)).replace('12', o.l).replace('( ', '(')
                                                                            }
                                                                        </p>
                                                                    </div>
                                                                ` : ''}
                                                                ${o.edo ? `
                                                                    <div class="benefit d-flex align-items-start mb-2">
                                                                        <img src="data:image/svg+xml;base64," alt="" class="mr-2 img-benefit mt-1 img-exlamation">
                                                                        <p class="text-benefit" ${o.dl < 0 ? `style="color:red"` : ''}>
                                                                            ${(o.dl > 1) 
                                                                                ? lang.END_ON_MORE_DAY.replace('end_date', o.edf).replace("<span translate='no'>2<\/span>", o.dl)
                                                                                : (
                                                                                    (o.dl > 0)
                                                                                        ? lang.END_ON_ONE_DAY.replace('end_date', o.edf)
                                                                                        : (
                                                                                            (o.dl == 0)
                                                                                                ? lang.ENDED_LAST_DAY.replace('end_date', o.edf)
                                                                                                : lang.ENDED.replace('end_date', o.edf)
                                                                                        )
                                                                                )
                                                                            }
                                                                        </p>
                                                                    </div>
                                                                ` : ''}
                                                            </div>
                                                        ` : ''}
        
                                                        ${o.hd ? `
                                                            <div class="wrapper-description">
                                                                <div class="card-description card-description-options ellipsis-text description-elipsis">
                                                                    <span class="text-description">${DOMPurify.sanitize((o.d))}</span>
                                                                </div>
                                                                <a href="javascript:void(0)" class="show-details">${lang.SHOW_DETAIL}</a>
                                                            </div>
                                                        ` : ''}
        
                                                        <button class="btn button-card show-form-donate" data-form-type="pilihan-dukungan" data-id="${o.i}" data-title="${o.t}" data-price="${o.p}" data-price-formatted="${o.p}" data-is-exclusive="${o.ec > 0}" data-exclusive-count="${o.ec}" data-is-shipping="${o.is}" data-is-answer="${o.ia}" data-is-early-access="${o.iea}" data-is-custom-reward="${o.icr}" data-question="${o.q}" ${o.id ? 'disabled' : ''}>${lang.SELECT_THIS}</button>
                                                    </div>
                                                </div>
                                            </div>
                                        `);

                                        setTimeout(() => {
                                            let showDetails = document.querySelectorAll(".card-description-options");
                                            showDetails.forEach((element) => {

                                                const charCount = $(element).parent().find("div>span").html();

                                                const isOverflowing = (element.scrollHeight > element.clientHeight || element.scrollHeight > 42) && charCount.length > 80;

                                                const toggleLink = $(element).parent().find("a");
                                                if (isOverflowing) {
                                                    toggleLink.addClass("d-inline-block").removeClass("d-none");
                                                } else {
                                                    toggleLink.addClass("d-none").removeClass("d-inline-block");
                                                }
                                            });

                                            $("#masonry-content").imagesLoaded(function () {
                                                $("#masonry-content").masonry({
                                                    itemSelector: ".grid-item",
                                                    isFitWidth: true,
                                                    horizontalOrder: true,
                                                    gutter: 40,
                                                });
                                            });
                                        }, 150);
        
                                    })
                                }
                            })
                            .always(() => {
                                hasLoaded.options = true;
                                reqToLoad.options = false;
                                changeCurrencyTribe();
                            })
                    }
                }
            }, 1000);
        }

        /** load about section */
        if (!hasLoaded.about && !reqToLoad.about && (userdata.about || userdata.user_video)) {
            if ($('#user-about-container').isInViewport()) {
                $('#user-about-container').html(`
                        <div class="wrapper-creatorVideo border-topCustom mt-custom__layout mb-custom__layout-tentang d-inline-block w-100">
                            <div class=" container-layout mt-customTop mb-0 ">
                                <h3 class="title-tribe text-left ">${lang.ABOUT.trim()} ${userdata.fullname}</h3>
                                ${userdata.user_video ? `
                                    <div class="wrapper-Creatorvideo w-100">
                                        <iframe width="100%" height="315" src="${userdata.user_video}" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen style="border-radius: 10px;" ></iframe>
                                    </div>
                                ` : ''}
                                ${userdata.about ? `
                                    <div class=" wrapper-tentang__text list custom-margin-desc">${userdata.about}</div>
                                ` : ''}
                            </div>
                        </div>
                    `);
                hasLoaded.about = true;
            }
        }

        /** load vote result */
        if ($('#vote-result-container').isInViewport()) {
            setTimeout(() => {
                if (!hasLoaded.voteResult && !reqToLoad.voteResult && userdata.vote_result_show) {
                    $('#vote-result-container').html(loaderEl)
                    if ($('#vote-result-container').isInViewport()) {
                        reqToLoad.voteResult = true;
                        $.getq('tribe', `/${userdata.username}/tribe/vote-api`, function (res) {
                            const resd = JSON.parse(atob(res.data));

                            $('#vote-result-container').html(`
                                <div class="wrapper-vote  border-topCustom mt-custom__layout mb-custom__layout d-inline-block w-100">
                                    <div id="vote-result-list" class="container-layout mt-customTop  mb-0">
                                        <h3 class="title-tribe text-left mb-21">${DOMPurify.sanitize(he.encode(userdata.vote_title))}</h3>
                                    </div>
                                </div>
                            `);
                            resd.map(v => {
                                $('#vote-result-list').append(`
                                    <div class="wrapper-voting__item mb-27">
                                        <div class="wrapper__item justify-content-between d-flex">
                                            <div class="wrapper-question__item">
                                                <p>${v.t ? v.t : ''}</p>
                                            </div>
                                            <div class="wrapper-totalCollect__item">
                                                <span class="collected-funds collected-funds-nowrap">
                                                    <span class="vote-nominal" data-base-currency="${userdata.base_currency}" data-base-nominal="${v.n}">(${userdata.base_currency}${nice_number(v.n)})</span>
                                                    <b class="collected-percent ml-1">${v.p}%</b>
                                                </span>
                                            </div>
                                        </div>
                                        <div class="wrapper-progressBarsPolling">
                                            <div class="progress progress-bar-striped progress-bar-animated">
                                                <div class="progress-bar bg-greenCustom" role="progressbar" style="width: ${v.p}%" aria-valuenow="${v.p}" aria-valuemin="0" aria-valuemax="100"></div>
                                            </div>
                                        </div>
                                    </div>
                                `);
                            });
                            if (userdata.vote_show) {
                                $('#vote-result-list').append(`
                                    <button class="button-vote btn show-form-donate" data-form-type="donate" data-toggle="modal" data-target="#donate-modal__GiveSupport">Vote</button>
                                `);
                            }
                            changeCurrencyTribe();
                        })
                        .always(() => {
                            reqToLoad.voteResult = false;
                            hasLoaded.voteResult = true;
                        })
                    }
                }
            }, 1000);
        }

        /** load grouping */
        if ($('#grouping-container').isInViewport()) {
            setTimeout(() => {
                if (!hasLoaded.grouping && !reqToLoad.grouping && (userdata.milestone_show || userdata.supp_count_show || userdata.supp_message_show || userdata.top_ten_show)) {
                    $('#grouping-container').html(loaderEl)
                    if ($('#grouping-container').isInViewport()) {
                        reqToLoad.grouping = true;
                        $.getq('tribe', `/${userdata.username}/tribe/grapi-v4`, function (res) {
                            const resd = JSON.parse(atob(res.data))
                            $('#grouping-container').html('')
                            if (userdata.milestone_show) {
                                $('#grouping-container').append(`
                                    <section class="wrapper-donate  border-topCustom mt-custom__layout mb-custom__layout d-inline-block w-100">
                                        <div class="container-layout mt-customTop mb-0">
                                            <h3 class="title-tribe text-left">${userdata.milestone_title}</h3>
                                            <div class="wrapper-voting__elements">
                                                <div class="wrapper-voting__element" id="wrappertargetMoney">
                                                    <h4 class="collected-now d-inline-block textFit" id="targetMoney">
                                                        <span class="current-currency">${userdata.base_currency}</span><span id="milestone-current" data-origin-milecurrent="${resd.td}">${
                                                            ((nonDecimalCurrencies.includes(client_tribe.CURRENCY)) ?
                                                            fNumb(resd.td, true, 0)
                                                            : fNumb(resd.td))
                                                        }</span>
                                                    </h4>
                                                    ${userdata.milestone_target > 0 ? `
                                                        <div class="wrapper-element__progresBar w-100 d-inline-block ">
                                                            <div class="wrapper-donate__text  d-flex justify-content-between">
                                                                <div class="target-donate__element">
                                                                    <p>Target <span class="current-currency">${userdata.base_currency}</span><span id="milestone-target" data-origin-miletarget="${userdata.milestone_target}">${
                                                                        (nonDecimalCurrencies.includes(client_tribe.CURRENCY)
                                                                        ? fNumb(userdata.milestone_target, true, 0)
                                                                        : fNumb(userdata.milestone_target))
                                                                    }</span></p>
                                                                </div>
                                                                <div class="total-element__percent  align-items-end text-right ">
                                                                    <p class="collected-percent">${resd.pd}%</p>
                                                                </div>
                                                            </div>
                                                            <div class="wrapper-progressBars">
                                                                <div class="progress progress-bar-striped progress-bar-animated ">
                                                                    <div class="progress-bar bg-greenCustom" role="progressbar" style="width: ${resd.pd}%" aria-valuenow="${resd.pd}" aria-valuemin="0" aria-valuemax="100"></div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    ` : ''}
                                                </div>
                                            </div>
                                            ${userdata.milestone_description ? `
                                                <div class="text-for__description list customMargin-textDescripttion">
                                                    <p class="mb-0">${userdata.milestone_description}</p>
                                                </div>
                                            ` : ''}
                                            <button class="button-donate btn mt-10 show-form-donate" data-form-type="donate">${userdata.support_button_text}</button>
                                        </div>
                                    </section>
                                `)
                            }
        
                            if (userdata.supp_count_show) {
                                $('#grouping-container').append(`
                                    <section class="wrapper-donate  border-topCustom mt-custom__layout mb-custom__layout d-inline-block w-100">
                                        <div class="container-layout mt-customTop mb-0">
                                            <h3 class="title-tribe text-left ">${userdata.supp_count_title}</h3>
                                            <div class="wrapper-voting__elements">
                                                <div class="wrapper-voting__element" id="wrapperTargetSupporter">
                                                    <h4 class="collected-now" id="targetSupporter">${resd.tp}</h4>
                                                    ${userdata.supp_count_target > 0 ? `
                                                        <div class="wrapper-element__progresBar w-100 d-inline-block ">
                                                            <div class="wrapper-donate__text  d-flex justify-content-between">
                                                                <div class="target-donate__element">
                                                                    <p>Target ${fNumb(userdata.supp_count_target)}</p>
                                                                </div>
                                                                <div class="total-element__percent align-items-end text-right ">
                                                                    <p class="collected-percent">${fNumb(resd.pp)}%</p>
                                                                </div>
                                                            </div>
                                                            <div class="wrapper-progressBars">
                                                                <div class="progress progress-bar-striped progress-bar-animated">
                                                                    <div class="progress-bar bg-greenCustom" role="progressbar" style="width: ${resd.pp}%" aria-valuenow="${resd.pp}" aria-valuemin="0" aria-valuemax="100"></div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    ` : ''}
                                                </div>
                                            </div>
                                            ${userdata.supp_count_description ? `
                                                <div class="text-for__description list customMargin-textDescripttion">
                                                    <p class="mb-0">${userdata.supp_count_description}</p>
                                                </div>
                                            ` : ''}
                                            <button class="button-donate btn mt-10 show-form-donate" data-form-type="donate">${userdata.support_button_text}</button>
                                        </div>
                                    </section>
                                `)
                            }
        
                            if (userdata.top_ten_show) {
                                $('#grouping-container').append(`
                                    <section class="wrapper-topTen  border-topCustom mt-custom__layout mb-custom__layout d-inline-block w-100">
                                        <div class="container-layout mt-customTop mb-0">
                                            <h3 class="title-tribe text-left ">Top Supporters</h3>
                                            <div class="wrapper-supporter__select">
                                                <form class="w-100 d-inline-block" style="margin-top: 2px;">
                                                    <div class="select-container">
                                                        <select id="top-ten-periode-select" class="select2 select-container__supporter">
                                                            <option></option>
                                                            <option value="0">${lang.FROM_BEGINNING}</option>
                                                            <option value="30">${lang.LAST_30_DAYS}</option>
                                                            <option value="7">${lang.LAST_7_DAYS}</option>
                                                        </select>
                                                    </div>
                                                </form>
                                            </div>
                                            ${resd.tt.li.length > 0 ? `
                                                <div id="top-ten-list" class="wrapper-list__topTen toptenListData"></div>
                                            ` : `
                                                <div id="top-ten-list" class="wrapper-list__topTen toptenListData">
                                                    <div class="list-1 d-flex align-items-center mt-12 justify-content-center">${lang.NO_DATA}</div>
                                                </div>
                                            `}
                                        </div>

                                        <span class="more-top"></span>

                                        ${resd.tt.hm ? `
                                            <div class="wrapper-seeMore__btn d-flex justify-content-center">
                                                <button class="btn-seeMore btn-seeMore-top">${lang.SEE_ALL}</button>
                                            </div>
                                        ` : ''}

                                    </section>
                                `)
                                $("#top-ten-periode-select").select2({
                                    minimumResultsForSearch: -1,
                                    placeholder: lang.FROM_BEGINNING,
                                    dropdownCssClass: "myFont",
                                });
                                $("#top-ten-periode-select").val(0).trigger('change');
                                resd.tt.li.map(item => {
                                    $('#top-ten-list').append(`
                                        <div class="list-1 d-flex align-items-center mt-12">
                                            <div class="${orderClass[item.no -1]}-number size-number">${item.no}</div>
                                            <div class="size-text__name ellipsis-name">${DOMPurify.sanitize(he.decode(item.fn))}</div> 
                                        </div>
                                    `);
                                });
                                toptenFirstLoad = true;
                            }
        
                            if (userdata.supp_message_show) {
                                $('#grouping-container').append(`
                                    <section class="wrapper-message border-topCustom mt-custom__layout mb-custom__layout d-inline-block w-100">
                                        <div class="container-layout mt-customTop mb-0 ">
                                            <h3 class="title-tribe text-left mb-16 ">${lang.MESSAGE}</h3>
                                            <button class="button-donate btn mb-20 show-form-donate" data-form-type="donate">${userdata.support_button_text}</button>
                                            <div id="supporter-message-container"></div>
                                            <span class="more-message"></span>
                                            <span class="total-message" id="${resd.me.co}"></span>
                                        </div>
                                        ${resd.me.co > 5 ? `
                                            <div class="wrapper-seeMore__btn d-flex justify-content-center">
                                                <button class="btn-seeMore btn-seeMore-message">${lang.SEE_ALL}</button>
                                            </div>
                                        ` : ''}
                                    </section>
                                `);
                                resd.me.li.map(item => {
                                    $('#supporter-message-container').append(`
                                        <div class="wrapper-messageComment mt-0 supp-message-item">
                                            <div class="wrapper-message__supporter">
                                                <div class="wrapper-content__message">
                                                    <p class="supporter-name__message">${DOMPurify.sanitize(he.decode(item.fu))}</p>
                                                    ${messageFormatter(item)}
                                                </div>
                                                ${item.re ? `
                                                    <div class="wrapper-message__creator margin-top-5 mt-10 ">
                                                        <div class="wrapper-content__message">
                                                            <div class="wrapper-creator__replyMessage d-flex">
                                                                <div class="user-image-comment">
                                                                    ${userdata.user_image ? `
                                                                        <img src="${s3}files/profile/influencer/${userdata.username}/${userdata.user_image}" alt="" class="creator-img__replyMessage"> 
                                                                    ` : `
                                                                        <div class="user-img-comment--icon">
                                                                            <i class="fas fa-user"></i>
                                                                        </div>
                                                                    `}
                                                                </div>
                                                                <div class="wrapper-creator--comment  w-100">
                                                                    <p class="creator-name__message">${DOMPurify.sanitize(he.decode(userdata.fullname))}</p>
                                                                    <p class="creator__message"><q>${DOMPurify.sanitize(he.decode(item.re))}</q></p>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                ` : ''}
                                            </div>
                                        </div>    
                                    `)
                                })

                                GreenAudioPlayer.init({
                                    selector: '.green-player',
                                    stopOthersOnPlay: true,
                                    enableKeystrokes: true
                                });
                            }
                        })
                        .always(() => {
                            reqToLoad.grouping = false;
                            hasLoaded.grouping = true;
                            changeCurrencyTribe();
                        })
                    }
                }
            }, 1000);
        }

        /** load post section */
        if ($('#posts-container').isInViewport()) {
            setTimeout(() => {
                if (!hasLoaded.post && !reqToLoad.post && userdata.posts_show) {
                    $('#posts-container').html(loaderEl)
                    if ($('#posts-container').isInViewport()) {
                        reqToLoad.post = true;
                        $.getq('tribe', `/${userdata.username}/tribe/posts-api`, function (res) {
                            const resd = JSON.parse(atob(res.data));

                            if(resd.hasPosts == null) {
                                $('#posts-container').html('');
                                reqToLoad.post = false;
                                hasLoaded.post = true;
                                return;
                            }
                            
                            $('#posts-container').html(`
                                <div class="card-conte mb-4 mx-auto border-topCustom mt-custom__layout mb-custom__layout d-inline-block w-100">
                                    <div class="wrapper-tabContent container-layout mb-0">
                                        <ul class="nav nav-tabs border-0" id="myTab" role="tablist">
                                            ${resd.popular_post ? `
                                                <li class="nav-item" role="presentation">
                                                    <a class="nav-link nav-gettarget pt-0 active pl-0 pb-1 pr-0 mr-3 mt-0" id="home-tab"  data-toggle="tab" href="#home" role="tab" aria-controls="home" aria-selected="true" >${lang.MOST_POPULAR}</a>
                                                </li>
                                            ` : ''}
                                            ${resd.newest_post ? `
                                                <li class="nav-item" role="presentation">
                                                    <a class="nav-link nav-gettarget pt-0 pl-0 pb-1 pr-0 mt-0" id="profile-tab" data-toggle="tab" href="#profile" role="tab" aria-controls="profile" aria-selected="false" >${lang.NEWEST}</a>
                                                </li>
                                            ` : ''}
                                        </ul>
                                        <div class="tab-content" id="myTabContent">
                                            ${resd.popular_post ? `
                                                <div class="tab-pane fade show active" id="home" role="tabpanel" aria-labelledby="home-tab">
                                                    <div id="popular-posts-container" class="content-card"></div>
                                                </div>
                                            ` : ''}
                                            <div class="tab-pane fade" id="profile" role="tabpanel" aria-labelledby="profile-tab">
                                                <div id="newest-posts-container" class="content-card"></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            `)
        
                            resd.popular_post.map((item, key) => {
                                $('#popular-posts-container').append(`
                                    <div class="card-product">
                                        <div class="col-12 d-flex mt-25 gap-custom p-0 bd-highlight justify-content-between ${((key < resd.popular_post.length -1) && (resd.popular_post.length < 4)) ? `pb-4 border-bottom` : ''}" style="width: 100%">
                                            <div class="content-text flex-grow-2 bd-highlight bd-highlight">
                                                <div class="title">
                                                    <div class="ellipsis mb-1-5">
                                                        <h6 class="font-bold-custom title-header mb-0">
                                                            <a href="/${userdata.username}/c/${item.tribe_post_id}/${item.slug}" style="text-decoration:none !important; color:#000">${item.title}</a>
                                                        </h6>
                                                    </div>
                                                    <div class="ellipsis mb-2">
                                                        <p class="title-description mb-0">
                                                            <a href="/${userdata.username}/c/${item.tribe_post_id}/${item.slug}" style="text-decoration:none !important; color:#000">${item.content}</a>
                                                        </p>
                                                    </div>
                                                </div>
                                                <div class="d-flex align-self-center mb-3 flex-wrap">
                                                    <div class="category-content mt-1 d-flex align-self-baseline flex-wrap">
                                                        <div class="ellipsisCategory text-truncate d-flex align-self-baseline col-12 p-0 flex-wrap">
                                                            <div class="div-category mr-customCategory ">
                                                                <p class="m-0 category">${item.post_date}</p>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="icon-content mt-1 d-flex align-items-start">
                                                        <div class="bg-rounded-share mr-customCategory line-height share-modal" title="${lang.SHARE}" data-url="${base_url}${userdata.username}/c/${item.tribe_post_id}/${item.slug}" data-title="${item.title}">
                                                            <i class="text-gray-custom font-size-10 share d-flex justify-content-center align-items-center">
                                                                <svg role="img" viewBox="2 2 22 22" fill="#838485" stroke-width="2" stroke="none" xmlns="http://www.w3.org/2000/svg" class="recommend-icon post-meta-icon" style="" class="text-gray-custom font-size-i"><g><title>${lang.SHARE}</title><path fill-rule="evenodd" clip-rule="evenodd" d="M20.7996 12.5084C21.0668 12.2221 21.0668 11.7777 20.7996 11.4914L13.0945 3.23664C12.8137 2.93576 12.3421 2.91951 12.0412 3.20035C11.884 3.34707 11.8045 3.54587 11.8045 3.74518H11.8045V8.32516C9.37206 8.45369 7.21389 9.2632 5.63546 11.0671C3.92131 13.0261 3.00032 16.0352 3.00024 20.2548C3.00024 20.5936 3.22876 20.8897 3.55649 20.9757C3.88421 21.0616 4.22865 20.9156 4.39487 20.6204C5.365 18.8974 6.32473 17.6899 7.54233 16.9C8.61721 16.2027 9.95543 15.7911 11.8045 15.7087V20.2548C11.8045 20.6664 12.1381 21.0001 12.5497 21.0001C12.7694 21.0001 12.9668 20.905 13.1032 20.7539L20.7996 12.5084ZM12.5353 9.7969C12.5289 9.79706 12.5225 9.79714 12.5161 9.79714C10.0794 9.79714 8.12197 10.4888 6.75716 12.0486C5.71118 13.2439 4.94986 15.0204 4.64175 17.5643C5.25768 16.8068 5.93857 16.1638 6.73113 15.6497C8.24968 14.6645 10.0982 14.203 12.5161 14.203L12.5333 14.2031L12.5497 14.203C12.9613 14.203 13.295 14.5366 13.295 14.9482V18.3641L19.2353 11.9999L13.295 5.63568V9.05181C13.295 9.46339 12.9613 9.79704 12.5497 9.79704C12.5449 9.79704 12.5401 9.79699 12.5353 9.7969Z"></path></g></svg>
                                                            </i>
                                                        </div>
                                                        ${item.tipe_dukungan > 0 ? `
                                                            <div class="bg-rounded-lock mr-customCategory" data-toggle="tooltip" data-placement="top" title="${lang.EXCLUSIVE}">
                                                                <i class="fa-solid fa-lock text-white margin-right-1"></i>
                                                            </div>
                                                        ` : ''}
                                                    </div>
                                                </div>
                                                <div class="d-flex align-self-baseline flex-wrap row-tanggal">
                                                    <div class="icon-info mr-3" style="margin-right:12px !important;">
                                                        <i class="far fa-eye text-gray-custom font-size-i"></i>
                                                        <span class="span-view text-gray-custom font-size-10">${item.viewers}</span>
                                                    </div>
                                                </div>
            
                                            </div>
                                            ${item.cover_image ? `
                                                <div class="img content-img-width bd-highlight ml-3">
                                                    <figure class="figure figure-content m-0 mb-4">
                                                        <a href="/${userdata.username}/c/${item.tribe_post_id}/${item.slug}">
                                                            <img src="${item.cover_image}" class="figure-img img-size img-fluid w-100 h-100 img-content rounded mb-0" alt="${item.title}"/>
                                                        </a>
                                                    </figure>
                                                </div>
                                            ` : ''}
                                        </div>
                                    </div>
                                `);
                            });
        
                            if (resd.count_popular_post > 3) {
                                $('#popular-posts-container').append(`
                                    <div class="see-all mt-4">
                                    <a href="/${userdata.username}/posts">
                                        ${lang.SEE_ALL} <i class="fa-solid fa-arrow-right ml-1"></i>
                                    </a>
                                    </div>
                                `)
                            }
        
                            resd.newest_post.map(item => {
                                $('#newest-posts-container').append(`
                                    <div class="card-product">
                                        <div class="col-12 d-flex mt-25 gap-custom p-0 bd-highlight justify-content-between pb-4 border-bottom" style="width: 100%">
                                            <div class="content-text flex-grow-2 bd-highlight bd-highlight">
                                                <div class="title">
                                                    <div class="ellipsis mb-1-5">
                                                        <h6 class="font-bold-custom title-header mb-0">
                                                            <a href="${base_url}${userdata.username}/c/${item.tribe_post_id}/${item.slug}" style="text-decoration:none !important; color:#000">${item.title}</a>
                                                        </h6>
                                                    </div>
                                                    <div class="ellipsis mb-2">
                                                        <p class="title-description mb-0">
                                                            <a href="${base_url}${userdata.username}/c/${item.tribe_post_id}/${item.slug}" style="text-decoration:none !important; color:#000">${item.content}</a>
                                                        </p>
                                                    </div>
                                                </div>
                                                <div class="d-flex align-self-center mb-3 flex-wrap">
                                                    <div class="category-content mt-1 d-flex align-self-baseline flex-wrap">
                                                        <div class="ellipsisCategory text-truncate d-flex align-self-baseline col-12 p-0 flex-wrap">
                                                            <div class="div-category mr-customCategory ">
                                                                <p class="m-0 category">${item.post_date}</p>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="icon-content mt-1 d-flex align-items-start">
                                                        <div class="bg-rounded-share mr-customCategory line-height share-modal" title="${lang.SHARE}" data-url="${base_url}${userdata.username}/c/${item.tribe_post_id}/${item.slug}" data-title="${item.title}">
                                                            <i class="text-gray-custom font-size-10 share d-flex justify-content-center align-items-center">
                                                                <svg role="img" viewBox="2 2 22 22" fill="#838485" stroke-width="2" stroke="none" xmlns="http://www.w3.org/2000/svg" class="recommend-icon post-meta-icon" style="" class="text-gray-custom font-size-i"><g><title>${lang.SHARE}</title><path fill-rule="evenodd" clip-rule="evenodd" d="M20.7996 12.5084C21.0668 12.2221 21.0668 11.7777 20.7996 11.4914L13.0945 3.23664C12.8137 2.93576 12.3421 2.91951 12.0412 3.20035C11.884 3.34707 11.8045 3.54587 11.8045 3.74518H11.8045V8.32516C9.37206 8.45369 7.21389 9.2632 5.63546 11.0671C3.92131 13.0261 3.00032 16.0352 3.00024 20.2548C3.00024 20.5936 3.22876 20.8897 3.55649 20.9757C3.88421 21.0616 4.22865 20.9156 4.39487 20.6204C5.365 18.8974 6.32473 17.6899 7.54233 16.9C8.61721 16.2027 9.95543 15.7911 11.8045 15.7087V20.2548C11.8045 20.6664 12.1381 21.0001 12.5497 21.0001C12.7694 21.0001 12.9668 20.905 13.1032 20.7539L20.7996 12.5084ZM12.5353 9.7969C12.5289 9.79706 12.5225 9.79714 12.5161 9.79714C10.0794 9.79714 8.12197 10.4888 6.75716 12.0486C5.71118 13.2439 4.94986 15.0204 4.64175 17.5643C5.25768 16.8068 5.93857 16.1638 6.73113 15.6497C8.24968 14.6645 10.0982 14.203 12.5161 14.203L12.5333 14.2031L12.5497 14.203C12.9613 14.203 13.295 14.5366 13.295 14.9482V18.3641L19.2353 11.9999L13.295 5.63568V9.05181C13.295 9.46339 12.9613 9.79704 12.5497 9.79704C12.5449 9.79704 12.5401 9.79699 12.5353 9.7969Z"></path></g></svg>
                                                            </i>
                                                        </div>
                                                        ${item.tipe_dukungan > 0 ? `
                                                            <div class="bg-rounded-lock mr-customCategory" data-toggle="tooltip" data-placement="top" title="${lang.EXCLUSIVE}" >
                                                                <i class="fa-solid fa-lock text-white margin-right-1"></i>
                                                            </div>
                                                        ` : ''}
                                                    </div>
                                                </div>
                                                <div class="d-flex align-self-baseline flex-wrap row-tanggal">
                                                    <div class="icon-info mr-3" style="margin-right:12px !important;  ">
                                                        <i class="far fa-eye text-gray-custom font-size-i"></i>
                                                        <span class="span-view text-gray-custom font-size-10">${item.viewers}</span>
                                                    </div>
                                                </div>
                                            </div>
                                            ${item.cover_image ? `
                                                <div class="img content-img-width bd-highlight ml-3">
                                                    <figure class="figure figure-content m-0 mb-4">
                                                        <a href="${base_url}${userdata.username}/c/${item.tribe_post_id}/${item.slug}">
                                                            <img src="${item.cover_image}" class="figure-img img-size img-fluid w-100 h-100 img-content rounded mb-0" alt="${item.title}"/>
                                                        </a>
                                                    </figure>
                                                </div>
                                            ` : ''}
                                        </div>
                                    </div>
                                `);
                            });
        
                            if (resd.count_newest_post > 3) {
                                $('#newest-posts-container').append(`
                                    <div class="see-all mt-4">
                                    <a href="/${userdata.username}/posts">
                                        ${lang.SEE_ALL} <i class="fa-solid fa-arrow-right ml-1"></i>
                                    </a>
                                    </div>
                                `);
                            }
        
                            $('[data-toggle="tooltip"]').tooltip();

                            // Set aspect ratio of box
                            var aspect_ratio = 1;
                            var $box = $(".figure-content");
                            
                            // Initial resize of .box
                            $(document).ready(function ($) {
                                $box.height($box.width() * aspect_ratio);
                            });

                            // Resize .box on browser resize
                            $(window).resize(function () {
                                $box.height($box.width() * aspect_ratio);
                            });
                            
                            // pin img
                            var aspect_ratio2 = 2 / 4;
                            // Store the jQuery object for future reference
                            var $box2 = $(".figure-content-pin");
                            
                            // Initial resize of .box2
                            $(document).ready(function ($) {
                                $box2.height($box2.width() * aspect_ratio2);
                            });

                            // Resize .box2 on browser resize
                            $(window).resize(function () {
                                $box2.height($box2.width() * aspect_ratio2);
                            });
                        })
                        .always(() => {
                            reqToLoad.post = false;
                            hasLoaded.post = true;
                        });
                    }
                }
            }, 1000);
        }
    });

    $(document).ready(() => {
        /* lazy load cover image */
        if (userdata.cover_image) {
            $('#cover-section').html(`
                <img src="${s3}files/profile/influencer/${userdata.username}/${userdata.cover_image}" alt="cover image" class="cover-img" loading="eager" onError="this.onerror=null;this.style.display='none';">
            `);
        }

        /* lazy load profile image */
        if (userdata.user_image) {
            $('#user-image-section').html(`
                <img src="${s3}files/profile/influencer/${userdata.username}/${userdata.user_image}" alt="" class="img-profile"  loading="eager" onerror="this.style.display='none'">
            `);
        }

        /** lazy load social media account */
        if (userdata.social_accounts) {
            if(userdata.social_accounts.length < 1) {
                $('#user-socials').remove();
            }
            userdata.social_accounts.map((account) => {
                if(account.title == 'Twitter') {
                    $('#user-socials').append(`
                        <div class="socmed">
                            <a href="${account.url}" target="_blank" rel="noopener noreferrer" data-toggle="tooltip" data-toggleSosmed="sosmed" data-placement="bottom" title="${account.title}">
                                <svg class="icon-sosmed icon__hover" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" style="width: 24px;margin-bottom: 4px;"><!--!Font Awesome Free 6.5.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2024 Fonticons, Inc.--><path d="M389.2 48h70.6L305.6 224.2 487 464H345L233.7 318.6 106.5 464H35.8L200.7 275.5 26.8 48H172.4L272.9 180.9 389.2 48zM364.4 421.8h39.1L151.1 88h-42L364.4 421.8z"></path></svg>
                            </a>
                        </div>
                    `)
                } else {
                    $('#user-socials').append(`
                        <div class="socmed">
                            <a href="${account.url}" target="_blank" rel="noopener noreferrer" data-toggle="tooltip" data-toggleSosmed="sosmed" data-placement="bottom" title="${account.title}"><i class="${account.icon}"></i></a>
                        </div>
                    `)
                }
            })
        }

        /** lazy load support button */
        if (userdata.support_button_show) {
            $('#support-button-container').html(`
                <button class="btn btn-support show-form-donate" data-form-type="donate">${userdata.support_button_text}</button>
            `).removeClass('mb-0')
        }

        /** lazy load buyme button */
        if (userdata.buyme_button_show) {
            $('#buyme-button-container').html(`
                <button class="btn btn-support show-form-donate" data-form-type="buyme">${userdata.buyme_button_text}</button>
            `)
        }
    });

    $(document).on('click', '.show-details', function () {
        if ($(this).siblings('.card-description').height() > 42) {
            $(this).siblings('.card-description').addClass('ellipsis-text')
            $(this).text(lang.SHOW_DETAIL)
        } else {
            $(this).siblings('.card-description').removeClass('ellipsis-text')
            $(this).text(lang.HIDE_DETAIL)
        }

        $("#masonry-content").masonry({
            itemSelector: ".grid-item",
      
            // percentPosition: true,
            isFitWidth: true,
            horizontalOrder: true,
            gutter: 40,
        });

        $("#masonry-wishlist-content").masonry({
            itemSelector: ".grid-item",
            isFitWidth: true,
            horizontalOrder: true,
            gutter: 40,
        });
    });

    $(document).on('change', "#top-ten-periode-select", function () {
        topten_page = 1;
        if(!toptenFirstLoad) return;
        $(".toptenListData").html(loaderEl);
        $.get(`/${userdata.username}/tribe/topten-api-v2/?per=${$(this).val()}`, function (res) {
            $(".toptenListData").html('');
            const resd = JSON.parse(atob(res.data))
            if(resd.tt.li.length > 0) {
                resd.tt.li.map(item => {
                    $('#top-ten-list').append(`
                        <div class="list-1 d-flex align-items-center mt-12">
                            <div class="${orderClass[item.no -1]}-number size-number">${item.no}</div>
                            <div class="size-text__name ellipsis-name">${item.fn}</div> 
                        </div>
                    `);
                });
            } else {
                $('#top-ten-list').append(`
                    <div class="list-1 d-flex align-items-center mt-12 justify-content-center">
                        ${lang.NO_DATA}
                    </div>
                `);
            }

            if (resd.tt.hm) {
                $('.btn-seeMore-top').show();
            } else {
                $('.btn-seeMore-top').hide();
            }
        });
    });

    $(document).on("click", ".btn-seeMore-message", function () {
        $('.btn-seeMore-message').prop("disabled", true);
        supp_message_page += 1;

        $('.more-message').html(loaderEl);
        $.get(`/${userdata.username}/tribe/message/more-api-v3/${supp_message_page}`, function (res) {
            const resd = JSON.parse(atob(res.data))
            resd.li.forEach(item => {
                $('#supporter-message-container').append(`
                        <div class="wrapper-messageComment mt-0 supp-message-item">
                            <div class="wrapper-message__supporter">
                                <div class="wrapper-content__message">
                                    <p class="supporter-name__message">${DOMPurify.sanitize(he.decode(item.fu))}</p>
                                    ${messageFormatter(item, supp_message_page)}
                                </div>
                                ${item.re ? `
                                    <div class="wrapper-message__creator margin-top-5 mt-10 ">
                                        <div class="wrapper-content__message">
                                            <div class="wrapper-creator__replyMessage d-flex">
                                                <div class="user-image-comment">
                                                    <img src="${s3}files/profile/influencer/${userdata.username}/${userdata.user_image}" alt="" class="creator-img__replyMessage"> 
                                                    <div class="user-img-comment--icon">
                                                        <i class="fas fa-user"></i>
                                                    </div>
                                                </div>
                                                <div class="wrapper-creator--comment  w-100">
                                                    <p class="creator-name__message">${DOMPurify.sanitize(he.decode(userdata.fullname))}</p>
                                                    <p class="creator__message"><q>${DOMPurify.sanitize(he.decode(item.re))}</q></p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                ` : ''}
                            </div>
                        </div>    
                    `)
            });

            GreenAudioPlayer.init({
                selector: `.green-player-${supp_message_page}`,
                stopOthersOnPlay: true,
                enableKeystrokes: true
            });

            if (resd.re <= 0) {
                $('.btn-seeMore-message').remove();
            }
        }, 'json')
        .always(() => {
            $('.btn-seeMore-message').prop("disabled", false);
            $('.more-message').html('');
        });
    });

    $(document).on("click", ".btn-seeMore-top", function () {
        $('.btn-seeMore-top').prop("disabled", true);
        topten_page += 1;

        $('.more-top').html(loaderEl);
        $.get(`/${userdata.username}/tribe/topten/more-api/${topten_page}`, function (res) {
            const resd = JSON.parse(atob(res.data))
            resd.tt.li.forEach(item => {
                $('#top-ten-list').append(`
                    <div class="list-1 d-flex align-items-center mt-12">
                        <div class="tenth-number size-number">${item.no + resd.tt.sk}</div>
                        <div class="size-text__name ellipsis-name">${DOMPurify.sanitize(he.decode(item.fn))}</div> 
                    </div>
                `);
            });

            if (!resd.tt.hm) {
                $('.btn-seeMore-top').hide();
            }
        }, 'json')
        .always(() => {
            $('.btn-seeMore-top').prop("disabled", false);
            $('.more-top').html('');
        });
    });

    $(document).on('click', ".share-modal", function (e) {
        var data = {
            url: $(this).data('url'),
            title: $(this).data('title'),
        };
        $('#exampleModal').data(data).modal('show');
    });

    $(document).on("click", "#copyLink", function (e) {
        var data = $(this).parents('#exampleModal').data();
        navigator.clipboard.writeText(data.url).then(function () {
            setTimeout(function () {
                $('[data-toggle="tooltip"]').tooltip("hide");
            }, 800);
        });
    });

    $(document).on('click', '#shareTwitter', function (e) {
        var data = $(this).parents('#exampleModal').data();
        window.open('http://twitter.com/share?url=' + encodeURIComponent(data.url).replaceAll('&', '%26'), '_blank');
    });

    $(document).on('click', '#shareFacebook', function (e) {
        var data = $(this).parents('#exampleModal').data();
        window.open('https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(data.url).replaceAll('&', '%26'), '_blank');
    });

    $(document).on('click', '#shareLinkedin', function (e) {
        var data = $(this).parents('#exampleModal').data();
        window.open('https://www.linkedin.com/sharing/share-offsite/??url=' + encodeURIComponent(data.url).replaceAll('&', '%26'), '_blank');
    });

    $(document).on('click', '#shareWhatsapp', function (e) {
        var data = $(this).parents('#exampleModal').data();
        window.open('https://api.whatsapp.com/send?text=' + data.title.replaceAll('&', '%26') + ' ' + encodeURIComponent(data.url).replaceAll('&', '%26'), '_blank');
    });

    $(document).on('click', '#shareEmail', function (e) {
        var data = $(this).parents('#exampleModal').data();
        window.open('mailto:?subject=' + data.title + '&body=' + encodeURIComponent(data.title + '\n' + data.url).replaceAll('&', '%26'));
    });
})