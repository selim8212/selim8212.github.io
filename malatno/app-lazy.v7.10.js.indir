/**
 * 250930: add green audio player
 */

$(function () {
    var supp_message_page = 1;
    var topten_page = 1;
    var reqToLoad = {
        wishlist: false,
        options: false,
        about: false,
        voteResult: false,
        grouping: false,
        post: false
    }
    var hasLoaded = {
        wishlist: false,
        options: false,
        about: false,
        voteResult: false,
        grouping: false,
        post: false
    };
    var hasWishlist = false;

    const orderClass = ['first', 'second', 'third', 'fourth', 'fifth', 'sixth', 'seventh', 'eighth', 'ninth', 'tenth'];
    var toptenFirstLoad = false;

    $.fn.isInViewport = function () {
        var elementTop = $(this).offset().top;
        var elementBottom = elementTop + $(this).outerHeight();

        var viewportTop = $(window).scrollTop();
        var viewportBottom = viewportTop + $(window).height();

        return elementBottom > viewportTop && elementTop < viewportBottom;
    };

    function queueMessageFormatter(message) {
        if(!message) return;

        if(message.qinfo && message.q) {
            return `<span style="color: #76CC11">(${DOMPurify.sanitize(he.decode(`${message.qinfo}: ${message.q}`))})</span>`
        }

        return '';
    }

    function wishlistMessage(message) {
        let note = message.no;
        if(!note) note = '';
        let title = message.wl_t;
        
        // remove message with title
        const cleanedMessage = note.replace(title, '').trim();

        // get pattern
        const match = cleanedMessage.match(/^\((Kontribusi ke wishlist:[^)]+)\)\s*(.*)/);
        const match2 = cleanedMessage.match(/^\((Contributed to wishlist:[^)]+)\)\s*(.*)/);

        let queueMessage = queueMessageFormatter(message);

        if(match) {
            if(!match[2]) {
                let formatted = `<span style="color: #76CC11">(${DOMPurify.sanitize(he.decode('Kontribusi ke wishlist: ' + title))})</span>`;

                if(queueMessage) {
                    formatted = `${formatted}<br/>${queueMessage}`
                }

                return formatted;
            } else {
                if(queueMessage) {
                    return `<span style="color: #76CC11">(${DOMPurify.sanitize(he.decode('Kontribusi ke wishlist: ' + title))})</span> <br/> ${queueMessage} <br/> <q>${DOMPurify.sanitize(he.decode(match[2]))}</q>`;
                } else {
                    return `<span style="color: #76CC11">(${DOMPurify.sanitize(he.decode('Kontribusi ke wishlist: ' + title))})</span> <br/> <q>${DOMPurify.sanitize(he.decode(match[2]))}</q>`;
                }
            }
        } else if(match2) {
            if(!match2[2]) {
                if(queueMessage) {
                    return `<span style="color: #76CC11">(${DOMPurify.sanitize(he.decode('Contributed to wishlist: ' + title))})</span> <br/> ${queueMessage}`;
                } else {
                    return `<span style="color: #76CC11">(${DOMPurify.sanitize(he.decode('Contributed to wishlist: ' + title))})</span>`;
                }
            } else {
                if(queueMessage) {
                    return `<span style="color: #76CC11">(${DOMPurify.sanitize(he.decode('Contributed to wishlist: ' + title))})</span> <br/> ${queueMessage} <br/> <q>${DOMPurify.sanitize(he.decode(match2[2]))}</q>`;
                } else {
                    return `<span style="color: #76CC11">(${DOMPurify.sanitize(he.decode('Contributed to wishlist: ' + title))})</span> <br/> <q>${DOMPurify.sanitize(he.decode(match2[2]))}</q>`;
                }
            }
        } else {
            formatted = `<q>${DOMPurify.sanitize(he.decode(note))}</q>`;
        }

        return note;
    }

    function voteMessageFormatterNoName(message) {
        const voteRegex = /^(.*?)(\s*\(Vote: .*?\))\s*$/;

        let match = false;
        if(message.no) {
            match = message.no.match(voteRegex);
        }

        let queueMessage = queueMessageFormatter(message);

        if (match) {
            const beforeVote = match[1].trim();
            const votePart = match[2];

            if (beforeVote !== '') {
                if(queueMessage) {
                    return `${queueMessage} <br/> <q>${beforeVote}</q> <br/> <span style='color: #76CC11'>${votePart}</span>`;
                } else {
                    return `<q>${beforeVote}</q> <br/> <span style='color: #76CC11'>${votePart}</span>`;
                }
            } else {
                if(queueMessage) {
                    return `${queueMessage} <br/> <span style='color: #76CC11'>${votePart}</span>`;
                } else {
                    return `<span style='color: #76CC11'>${votePart}</span>`;
                }
            }
        } else {
            if(queueMessage) {
                if(message.no) {
                    return `${queueMessage}<br/><q>${message.no}</q>`;
                } else {
                    return `${queueMessage}`;
                }
            } else {
                if(message.no) {
                    return `<q>${message.no}</q>`;
                } else {
                    return '';
                }
            }
        }
    }

    function voteMessageFormatter(message) {
        if (!message.vote_title) {
            return voteMessageFormatterNoName(message);
        }
        
        let queueMessage = queueMessageFormatter(message);

        let cleanedMessage = '';
        let match = false;
        
        const voteRegex = /^(.*?)(\s*\(Vote: .*?\))\s*$/;
        if(message.no) {
            cleanedMessage = message.no.replace(message.vote_title, '').trim();
            match = cleanedMessage.match(voteRegex);
        }

        if (match) {
            const beforeVote = match[1].trim();

            if (beforeVote !== '') {
                if(queueMessage) {
                    return `${queueMessage}<br/><q>${escapeHtml(beforeVote)}</q> <br/> <span style='color: #76CC11'>(Vote: ${escapeHtml(message.vote_title)})</span>`;
                } else {
                    return `<q>${escapeHtml(beforeVote)}</q> <br/> <span style='color: #76CC11'>(Vote: ${escapeHtml(message.vote_title)})</span>`;
                }
            } else {
                if(queueMessage) {
                    return `${queueMessage}<br/><span style='color: #76CC11'>(Vote: ${escapeHtml(message.vote_title)})</span>`;
                } else {
                    return `<span style='color: #76CC11'>(Vote: ${escapeHtml(message.vote_title)})</span>`;
                }
            }
        } else {
            if(queueMessage) {
                if(message.no) {
                    return `${queueMessage}<br/><q>${escapeHtml(message.no)}</q>`;
                } else {
                    return `${queueMessage}`;
                }
            } else {
                if(message.no) {
                    return `<q>${escapeHtml(message.no)}</q>`;
                } else {
                    return '';
                }
            }
        }
    }

    function messageOnlyFormatter(message) {
        let messageFormatted = '';
        if(message.is_wl) {
            messageFormatted = wishlistMessage(message);
        } else {
            if(message.is_vote) {
                messageFormatted = `<p class="supporter__message">${voteMessageFormatter(message)}</p>`;
            } else {
                let queueMessage = queueMessageFormatter(message);
                if(queueMessage) {
                    messageFormatted = `<p class="supporter__message">${queueMessage}<br/><q>${DOMPurify.sanitize(he.decode(message.no))}</q></p>`;
                    if(message.no) {
                    } else {
                        messageFormatted = `<p class="supporter__message">${queueMessage}</p>`;
                    }
                } else {
                    messageFormatted = `<p class="supporter__message"><q>${DOMPurify.sanitize(he.decode(message.no))}</q></p>`;
                    if(message.no) {
                    } else {
                        messageFormatted = `<p class="supporter__message"></p>`;
                    }
                }
            }
        }

        if(message.vn && !message.isb) {
            messageFormatted = messageFormatted.replace(/<q>.*?<\/q>/g, '');
        }

        return messageFormatted;
    }

    function messageFormatter(message, page = 1) {
        if(!message) return;

        if(message.vn) {
            let greenPlayerClass = 'green-player';
            if(page && page > 1) {
                greenPlayerClass = 'green-player-'+page;
            }
            
            const audioPlayer = `
                    <div class="supporter__messageAudio">
                        <div class="${greenPlayerClass} ready-player-4 player-with-accessibility">
                            <audio controls>
                                <source src="${message.vn}" type="audio/ogg">
                                <source src="${message.vn}" type="audio/mpeg">
                                Your browser does not support the audio element.
                            </audio>
                        </div>
                    </div>
                `;
            
            const messageFormatted = messageOnlyFormatter(message);

            return messageFormatted + audioPlayer;
        }
        
        return messageOnlyFormatter(message);
    }

    // HTML escaping helper
    function escapeHtml(text) {
        return text
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    function nice_number(n) {
        if (!n || n === 0 || n === '0') return '0';
        
        n = parseFloat(n.toString().replace(/,/g, ''));
        if (isNaN(n)) return false;
        
        const abbreviations = ['', 'K', 'M', 'B', 'T'];
        const index = Math.floor(Math.log10(n) / 3);
        
        const formattedNumber = (n / Math.pow(10, index * 3)).toFixed(index === 0 ? 0 : 1);
        
        // Remove trailing ".0" if it exists
        const formattedNumberWithoutDecimal = formattedNumber.replace(/\.0$/, '');
        
        return formattedNumberWithoutDecimal + abbreviations[index];
    }

    if(typeof changeCurrencyTribe !== 'function') {
        function changeCurrencyTribe() {
            if(document.getElementById('currencyOption')) {
