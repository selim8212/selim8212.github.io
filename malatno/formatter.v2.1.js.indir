/**
 * Formatter V2.0
 * Update delegasi jquery 
 * untuk handle form ajax
 */

function nonDecimalCeilFormat(number, isFloor=true) {
    let num = new BigNumber(number);
    num = num.decimalPlaces(0, isFloor ? BigNumber.ROUND_DOWN : BigNumber.ROUND_UP);
    if (num < 10000) {
        return numeral(num).format('0');
    }
    return numeral(num).format('0,0');
}
window.nonDecimalCeilFormat = nonDecimalCeilFormat;

function fNumb(number, isFloor=true, decimal=2, excluded=false) {
    if (nonDecimalCurrencies.includes($('#currencyOption').val()) && !excluded) {
        return nonDecimalCeilFormat(number, isFloor);
    }
    let num = new BigNumber(number);
    num = num.decimalPlaces(decimal, isFloor ? BigNumber.ROUND_DOWN : BigNumber.ROUND_UP);
    if (num < 10000) {
        if (num % 1 === 0) {
            return numeral(num).format('0');
        }
        if (num % 0.1 === 0) {
            return numeral(num).format('0.0');
        }
        if (num % 0.01 === 0 || decimal === 2) {
            return numeral(num).format('0.00');
        }
        return numeral(num).format('0.000');
    }
    if (num % 1 === 0) {
        return numeral(num).format('0,0');
    }
    if (num % 0.1 === 0 || decimal === 2) {
        return numeral(num).format('0,0.0');
    }
    return numeral(num).format('0,0.000');
}
window.fNumb = fNumb;

function formatLargeNumber(number) {
    let suffix = '';
    if (number >= 1000 && number < 1000000) {
        number = number / 1000;
        suffix = 'K';
    } else if (number >= 1000000 && number < 1000000000) {
        number = number / 1000000;
        suffix = 'M';
    } else if (number >= 1000000000) {
        number = number / 1000000000;
        suffix = 'B';
    }
    return number.toLocaleString(undefined, {maximumFractionDigits: (number < 10 && suffix == 'K') ? 1 : 1}) + suffix;
}
window.formatLargeNumber = formatLargeNumber;

function formatLargeNumber2(number, decimal) {
    let suffix = '';
    if (number >= 1000 && number < 1000000) {
        number = number / 1000;
        suffix = 'K';
    } else if (number >= 1000000 && number < 1000000000) {
        number = number / 1000000;
        suffix = 'M';
    } else if (number >= 1000000000) {
        number = number / 1000000000;
        suffix = 'B';
    }

    if(!suffix) {
        return number.toLocaleString(undefined, {maximumFractionDigits: decimal}) + suffix;
    } else {
        return number.toLocaleString(undefined, {maximumFractionDigits: (number < 10 && suffix == 'K') ? 1 : 1}) + suffix;
    }
}
window.formatLargeNumber2 = formatLargeNumber2;

function _floorPriceFormat(number) {
	if (number < 10000) {
		if (number % 1 == 0) {
			return numeral(number).format('0');
		} else {
			return numeral(number).format('0.00');
		}
	} else {
		if (number % 1 == 0) {
			return numeral(number).format('0,0');
		} else {
			return numeral(number).format('0,0.00');
		}
	}
}
window._floorPriceFormat = _floorPriceFormat;

function _twoDigitFormat(number) {
	if (parseInt(number) < 10) return '0' + number;
	return number;
}
window._twoDigitFormat = _twoDigitFormat;

function _conditionalFormatNumber(number) {
	if (number < 10000) {
		if (number % 1 == 0) {
			return numeral(number).format('0');
		} else {
			return numeral(number).format('0.00');
		}
	} else {
		if (number % 1 == 0) {
			return numeral(number).format('0,0');
		} else {
			return numeral(number).format('0,0.00');
		}
	}
}
window._conditionalFormatNumber = _conditionalFormatNumber;