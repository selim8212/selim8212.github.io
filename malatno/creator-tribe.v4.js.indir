      );
    })
    .on("input", function () {
      this.style.height = "auto";
      this.style.height = this.scrollHeight + "px";
      if (this.id === "yt-link") {
        $("#yt-preview").attr(
          "src",
          "https://www.youtube.com/embed/" + ytIdParser(this.value)
        );
      }
    });
  
