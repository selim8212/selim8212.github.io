  function resize(parent, children, children2) {
    var parentOfWord = $(parent);
    var word = $(children);
    var word2 = $(children2);
  
    var size = 36;
    word.css("font-size", size);
    word2.css("font-size", size);
  
    while (word.width() >= parentOfWord.width()) {
      word.css("font-size", --size);
      word2.css("font-size", --size);
  
      // }
      // while (word.width() <= parentOfWord.width()) {
      //   word.css("font-size", size);
      // }
    }
  }
  resize(".wrapper-voting__element", "#targetMoney", "#targetSupporter");
  
  jQuery(window).resize(function () {
    function resize(parent, children, children2) {
      var parentOfWord = $(parent);
      var word = $(children);
      var word2 = $(children2);
  
      var size = 36;
      word.css("font-size", size);
      word2.css("font-size", size);
  
      while (word.width() >= parentOfWord.width()) {
        word.css("font-size", --size);
        word2.css("font-size", --size);
  
        // }
        // while (word.width() <= parentOfWord.width()) {
        //   word.css("font-size", size);
        // }
      }
      word.css("font-size", size);
      word2.css("font-size", size);
    }
    resize(".wrapper-voting__element", "#targetMoney", "#targetSupporter");
  });
  
  
