  // icon love
  function iconHeart(targetAction) {
    $(targetAction).click(function (e) {
      e.preventDefault();
      if (targetAction !== ".text-iconHeart") {
        $(e.target.children[0].children[0]).toggleClass(
          "fa-solid fa-heart iconHeartClick"
        );
        $(e.target.children[0].children[0]).toggleClass(
          "far fa-heart  text-gray-custom  font-size-i"
        );
      }
      if (targetAction == ".text-iconHeart") {
        $(".iconHeart").toggleClass("fa-solid fa-heart iconHeartClick");
        $(".iconHeart").toggleClass(
          "far fa-heart  text-gray-custom  font-size-i"
        );
      }
    });
  }
